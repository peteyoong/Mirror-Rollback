# ============================================
# MIRROR - STAGING ENVIRONMENT
# ============================================
# Used for TestFlight builds and staging web
# Points to staging backend and staging database
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=staging

# API Configuration (single source of truth)
# Points to the BACKEND API origin serving /api/*
EXPO_PUBLIC_API_BASE_URL=https://api-staging.mirror.emergentagent.com

# Build provenance (updated at build time)
EXPO_PUBLIC_BUILD_VERSION=staging-v1.0.0
EXPO_PUBLIC_BUILD_ID=2026-02-17T14:00:00Z

# Debug mode (enabled in staging for testing)
EXPO_PUBLIC_DEBUG_MIRROR=true

# EAS Build configuration
EAS_BUILD_PROFILE=staging
