# ============================================
# MIRROR - STAGING ENVIRONMENT
# ============================================
# Staging deployment for QA and testing
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=staging

# API Configuration (single source of truth)
EXPO_PUBLIC_API_BASE_URL=https://cache-buster-21.preview.emergentagent.com

# Build provenance
EXPO_PUBLIC_BUILD_VERSION=v_stage_unified_001
EXPO_PUBLIC_BUILD_ID=web_20260218_182238

# Debug mode (enabled in staging for QA)
EXPO_PUBLIC_DEBUG_MIRROR=false

# Expo tunnel config
EXPO_TUNNEL_SUBDOMAIN=cache-buster-21
EXPO_PACKAGER_HOSTNAME=https://cache-buster-21.preview.emergentagent.com
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/app/frontend/.metro-cache
