# ============================================
# MIRROR - STAGING ENVIRONMENT (ALWAYS-ON)
# ============================================
# Staging deployment - uses ALWAYS-ON deployed host
# NOT preview/stage-preview (those sleep!)
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=staging

# API Configuration - ALWAYS-ON DEPLOYED HOST
# This is the deployed URL that NEVER sleeps
EXPO_PUBLIC_API_BASE_URL=https://mirror-lens-fixes.emergent.host

# Build provenance
EXPO_PUBLIC_BUILD_VERSION=v_stage_keepalive_001
EXPO_PUBLIC_BUILD_ID=stage_keepalive_20260221_085938

# Debug mode (enabled in staging for QA)
EXPO_PUBLIC_DEBUG_MIRROR=false

# Expo tunnel config
EXPO_TUNNEL_SUBDOMAIN=expo-bundle-issue
EXPO_PACKAGER_HOSTNAME=https://mirror-lens-fixes.emergent.host
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/app/frontend/.metro-cache
