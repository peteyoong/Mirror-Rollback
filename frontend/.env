# ============================================
# MIRROR - DEVELOPMENT ENVIRONMENT
# ============================================
# Used for local development with Expo tunnel
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=dev

# API Configuration (single source of truth)
EXPO_PUBLIC_API_BASE_URL=https://env-versioner.preview.emergentagent.com

# Build provenance
EXPO_PUBLIC_BUILD_VERSION=dev-local
EXPO_PUBLIC_BUILD_ID=dev

# Debug mode (enabled in dev)
EXPO_PUBLIC_DEBUG_MIRROR=true

# Expo tunnel config (dev only)
EXPO_TUNNEL_SUBDOMAIN=env-versioner
EXPO_PACKAGER_HOSTNAME=https://env-versioner.preview.emergentagent.com
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/app/frontend/.metro-cache
