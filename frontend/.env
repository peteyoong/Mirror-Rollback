# ============================================
# MIRROR - STAGING ENVIRONMENT
# ============================================
# Staging deployment for QA and testing
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=staging

# API Configuration (single source of truth)
EXPO_PUBLIC_API_BASE_URL=https://cachebuster-2.preview.emergentagent.com

# Build provenance
EXPO_PUBLIC_BUILD_VERSION=staging-v1.0.0
EXPO_PUBLIC_BUILD_ID=staging

# Debug mode (enabled in staging for QA)
EXPO_PUBLIC_DEBUG_MIRROR=true

# Expo tunnel config
EXPO_TUNNEL_SUBDOMAIN=cachebuster-2
EXPO_PACKAGER_HOSTNAME=https://cachebuster-2.preview.emergentagent.com
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/app/frontend/.metro-cache
