# ============================================
# MIRROR - STAGING ENVIRONMENT
# ============================================
# Staging deployment for QA and testing
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=staging

# API Configuration (single source of truth)
EXPO_PUBLIC_API_BASE_URL=https://expo-bundle-issue.preview.emergentagent.com

# Build provenance
EXPO_PUBLIC_BUILD_VERSION=v_stage_deploy_ready
EXPO_PUBLIC_BUILD_ID=deploy_20260221_081112

# Debug mode (enabled in staging for QA)
EXPO_PUBLIC_DEBUG_MIRROR=false

# Expo tunnel config
EXPO_TUNNEL_SUBDOMAIN=expo-bundle-issue
EXPO_PACKAGER_HOSTNAME=https://expo-bundle-issue.preview.emergentagent.com
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/app/frontend/.metro-cache
