# Environment identifier - STAGING
EXPO_PUBLIC_ENV=staging

# API Configuration - STAGING ALWAYS-ON HOST
EXPO_PUBLIC_API_BASE_URL=https://mirror-lens-fixes.emergent.host

# Build provenance
