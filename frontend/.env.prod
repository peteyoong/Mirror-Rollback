# ============================================
# MIRROR - PRODUCTION ENVIRONMENT
# ============================================
# Used for App Store builds and production web
# Points to production backend and production database
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=prod

# API Configuration (single source of truth)
# Points to the BACKEND API origin serving /api/*
EXPO_PUBLIC_API_BASE_URL=https://api.mirror.emergentagent.com

# Build provenance (updated at build time)
EXPO_PUBLIC_BUILD_VERSION=prod-v1.0.0
EXPO_PUBLIC_BUILD_ID=2026-02-17T14:00:00Z

# Debug mode (DISABLED in production)
EXPO_PUBLIC_DEBUG_MIRROR=false

# EAS Build configuration
EAS_BUILD_PROFILE=production
