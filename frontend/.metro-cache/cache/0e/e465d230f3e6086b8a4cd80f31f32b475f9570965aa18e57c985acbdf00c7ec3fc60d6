onst loadFieldSignals = async () => {\n      try {\n        setFieldLoading(true);\n        const response = await api.default.get(`/human-design/field-signals/${userId}`);\n        setFieldSignals(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load field signals:', error);\n      } finally {\n        setFieldLoading(false);\n      }\n    };\n    const loadReflectorSynthesis = async () => {\n      try {\n        setReflectorSynthesisLoading(true);\n        const response = await api.default.get(`/journal/${userId}/reflector-synthesis`);\n        setReflectorSynthesis(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load reflector synthesis:', error);\n      } finally {\n        setReflectorSynthesisLoading(false);\n      }\n    };\n\n    // Load data when tab or user changes\n    (0, _react.useEffect)(() => {\n      loadTabData(activeTab);\n    }, [activeTab, userId]);\n\n    // Load centers definition for bodygraph highlighting when Deep Dive tab is active\n    (0, _react.useEffect)(() => {\n      if (activeTab === 'deep_dive') {\n        loadCentersDefinition();\n        loadDeepDiveData();\n      }\n    }, [activeTab, userId]);\n    const loadCentersDefinition = async () => {\n      try {\n        const response = await api.default.get(`/human-design/centers/${userId}`);\n        const centersDef = {};\n        response.data.centers?.forEach(c => {\n          // Map center_name to boolean defined status\n          const name = c.center_name || c.name;\n          if (name) {\n            centersDef[name.toLowerCase()] = c.defined === true;\n          }\n        });\n        setCentersDefinition(centersDef);\n        setCentersData(response.data); // Store full centers data for Deep Dive\n      } catch (err) {\n        console.error('Failed to load centers definition:', err);\n      }\n    };\n\n    // Load all Deep Dive data (gates, sequences)\n    const loadDeepDiveData = async () => {\n      try {\n