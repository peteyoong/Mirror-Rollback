     }\n    };\n    const loadFieldSignals = async () => {\n      try {\n        setFieldLoading(true);\n        const response = await api.default.get(`/human-design/field-signals/${userId}`);\n        setFieldSignals(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load field signals:', error);\n      } finally {\n        setFieldLoading(false);\n      }\n    };\n    const loadReflectorSynthesis = async () => {\n      try {\n        setReflectorSynthesisLoading(true);\n        const response = await api.default.get(`/journal/${userId}/reflector-synthesis`);\n        setReflectorSynthesis(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load reflector synthesis:', error);\n      } finally {\n        setReflectorSynthesisLoading(false);\n      }\n    };\n\n    // Load data when tab or user changes\n    (0, _react.useEffect)(() => {\n      loadTabData(activeTab);\n    }, [activeTab, userId]);\n\n    // Load centers definition for bodygraph highlighting when Deep Dive tab is active\n    (0, _react.useEffect)(() => {\n      if (activeTab === 'deep_dive') {\n        loadCentersDefinition();\n        loadDeepDiveData();\n      }\n    }, [activeTab, userId]);\n\n    // Session-3d: canonical single fetch of /mechanics is now performed\n    // by loadTabData('summary'/'at_a_glance') on mount, which then caches\n    // the payload into `mechanicsPayload`.  No separate fetch effect is\n    // needed here — the deep-dive sections consume the cached payload via\n    // props, and the guard in loadTabData prevents duplicate refetches.\n    const mechanicsRequestedFor = (0, _react.useRef)(null);\n    const loadCentersDefinition = async () => {\n      try {\n        const response = await api.default.get(`/human-design/centers/${userId}`);\n        const centersDef = {};\n        response.data.centers?.forEach(c => {\n          // Map center_name to boolean defined status\n          const name = c.center_name || c.name;