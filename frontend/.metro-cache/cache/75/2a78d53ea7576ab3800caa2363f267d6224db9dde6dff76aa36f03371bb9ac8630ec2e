pattern-interpretation/${userId}/${domainId}`);\n    return response.data;\n  };\n\n  // ============================================\n  // FORUM PULSE\n  // ============================================\n\n  // Extended Forum Member Lens Data (full lens profile)\n\n  // Forum Dynamics Context for AI interpretation\n\n  const getForumPulse = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/pulse`, {\n      params: {\n        user_id: userId\n      }\n    });\n    return response.data;\n  };\n\n  // Get detailed lens data for a specific forum member\n  const getForumMemberLens = async (forumId, memberUserId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/member-lens/${memberUserId}`, {\n      params: {\n        user_id: userId\n      }\n    });\n    return response.data;\n  };\n\n  // Get forum dynamics context (for future Forum Chat integration)\n  const getForumDynamicsContext = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/dynamics-context`, {\n      params: {\n        user_id: userId\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM LIVE FIELD - Real-time field dynamics reading\n  // =====================================================\n\n  const getForumLiveField = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/live-field`, {\n      params: {\n        user_id: userId\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM CHAT TYPES & API\n  // =====================================================\n\n  // Get forum chat history\n  const getForumChatHistory = async (forumId, userId, limit = 50) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/chat/history`, {\n      params: {\n        user_id: userId,\n        limit\n      }\n    });\n    return response.data;\n  };\n\n  // Send forum chat message\n  const sendForumChatMessage = async (forumId, request) => {\n    const response = await apiWithRetry.post(`/forums/${forumId}/chat`, request);\n    return response.data;\n  };\n\n  // Forum Story API\n\n  const getForumStory = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/story`, {\n      params: {\n        user_id: userId\n      }\n    });\n    return response.data;\n  };\n\n  // Pairwise Dynamics API\n\n  const getPairwiseDynamics = async (forumId, userId, memberAId, memberBId) => {\n    const response = await apiWithRetry.post(`/forums/${forumId}/pairwise-dynamics`, {\n      user_id: userId,\n      member_a_id: memberAId,\n      member_b_id: memberBId\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM HD MAPPING API - \"How they map to me\"\n  // =====================================================\n\n  const getForumMemberMappings = async (forumId, userId) => {\n    // Use a unique URL path with cache-buster to completely bypass CDN edge caching\n    // Cloudflare caches by URL+method, so changing the URL path forces fresh fetch\n    const cacheBuster = Date.now();\n    const response = await apiWithRetry.post(`/forum-mappings?_cb=${cacheBuster}`, {\n      forum_id: forumId,\n      user_id: userId\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // WHAT EACH PERSON BRINGS — compact per-member contribution cards\n  // =====================================================\n\n  const getForumContributions = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/contributions`, {\n      params: {\n        user_id: userId,\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM MEMBER SUMMARY CARD (Interactive, inline)\n  // =====================================================\n\n  const getForumMemberSummary = async (forumId, memberId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/member-summary/${memberId}`, {\n      params: {\n        user_id: userId,\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // LIFE SYNTHESIS ENGINE (Phase 1a v1a2)\n  // =====================================================\n\n  const getLifeSynthesis = async (context, userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/${context}/synthesis/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n  const getLifeRoleCard = async (userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/role-card/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // MIRROR EVIDENCE LAYER (Phase 2)\n  // =====================================================\n\n  const getLifeEvidence = async (context, userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/${context}/evidence/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // TODAY MODULATION (Phase 2 continued)\n  // =====================================================\n\n  const getLifeToday = async (context, userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/${context}/today/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });