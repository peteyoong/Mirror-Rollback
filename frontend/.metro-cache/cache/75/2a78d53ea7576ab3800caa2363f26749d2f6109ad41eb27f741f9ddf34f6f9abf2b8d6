onse = await apiWithRetry.post(`/forums/${forumId}/chat`, request);\n    return response.data;\n  };\n\n  // Forum Story API\n\n  const getForumStory = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/story`, {\n      params: {\n        user_id: userId\n      }\n    });\n    return response.data;\n  };\n\n  // Pairwise Dynamics API\n\n  const getPairwiseDynamics = async (forumId, userId, memberAId, memberBId) => {\n    const response = await apiWithRetry.post(`/forums/${forumId}/pairwise-dynamics`, {\n      user_id: userId,\n      member_a_id: memberAId,\n      member_b_id: memberBId\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM HD MAPPING API - \"How they map to me\"\n  // =====================================================\n\n  const getForumMemberMappings = async (forumId, userId) => {\n    // Use a unique URL path with cache-buster to completely bypass CDN edge caching\n    // Cloudflare caches by URL+method, so changing the URL path forces fresh fetch\n    const cacheBuster = Date.now();\n    const response = await apiWithRetry.post(`/forum-mappings?_cb=${cacheBuster}`, {\n      forum_id: forumId,\n      user_id: userId\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // WHAT EACH PERSON BRINGS — compact per-member contribution cards\n  // =====================================================\n\n  const getForumContributions = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/contributions`, {\n      params: {\n        user_id: userId,\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM MEMBER SUMMARY CARD (Interactive, inline)\n  // =====================================================\n\n  const getForumMemberSummary = async (forumId, memberId, use