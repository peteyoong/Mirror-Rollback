    const cacheBuster = Date.now();\n    const response = await apiWithRetry.post(`/forum-mappings?_cb=${cacheBuster}`, {\n      forum_id: forumId,\n      user_id: userId\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // WHAT EACH PERSON BRINGS — compact per-member contribution cards\n  // =====================================================\n\n  const getForumContributions = async (forumId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/contributions`, {\n      params: {\n        user_id: userId,\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // FORUM MEMBER SUMMARY CARD (Interactive, inline)\n  // =====================================================\n\n  const getForumMemberSummary = async (forumId, memberId, userId) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/member-summary/${memberId}`, {\n      params: {\n        user_id: userId,\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // BETWEEN YOU TODAY — Relationship Timing Layer v1\n  // =====================================================\n\n  const getBetweenYouToday = async (forumId, userId, memberId, options) => {\n    const response = await apiWithRetry.get(`/forums/${forumId}/between-you-today`, {\n      params: {\n        user_id: userId,\n        member_id: memberId,\n        ...(options?.refresh ? {\n          refresh: true\n        } : {}),\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // Telemetry — passive observation, fire-and-forget. Never throws.\n\n  const postBetweenYouTodayEvent = async (forumId, userId, memberId, event, meta) => {\n    try {\n      await apiWithRetry.post(`/forums/${forumId}/between-you-today/event`, {\n        event,\n        user_id: userId,\