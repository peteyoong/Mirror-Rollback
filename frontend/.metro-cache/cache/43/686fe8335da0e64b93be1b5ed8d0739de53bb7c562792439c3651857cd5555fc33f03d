=====================\n  // PHASE TIMELINE (Mirror Phase Engine)\n  // =====================================================\n\n  const getLifePhases = async (userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/phases/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // REFLECTIONS — quick thought capture from Life tab\n  // =====================================================\n\n  const saveReflection = async payload => {\n    const response = await apiWithRetry.post('/reflections', payload);\n    return response.data;\n  };\n  const listReflections = async (userId, domain) => {\n    const response = await apiWithRetry.get(`/reflections/${userId}`, {\n      params: domain ? {\n        domain\n      } : undefined\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // ASK ABOUT MY LIFE — Mirror Life Interpreter\n  // =====================================================\n\n  const askAboutLife = async (userId, payload) => {\n    const response = await apiWithRetry.post(`/life/ask/${userId}`, payload, {\n      timeout: 60000 // LLM call can take time\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // PATTERN SIGNALS API (Why this is showing up)\n  // =====================================================\n\n  const getPatternSignals = async userId => {\n    const response = await apiWithRetry.get(`/pattern-signals/${userId}`);\n    return response.data;\n  };\n\n  // =====================================================\n  // CROSS-LENS PATTERN DIAGNOSIS API\n  // =====================================================\n\n  // V3.1: Home insight with angle system data\n\n  /**\n   * Get cross-lens pattern diagnosis.\n   * Returns ONE integrated interpretation, not