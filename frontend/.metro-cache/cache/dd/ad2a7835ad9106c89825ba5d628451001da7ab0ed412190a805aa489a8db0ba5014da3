ervation, fire-and-forget. Never throws.\n\n  const postBetweenYouTodayEvent = async (forumId, userId, memberId, event, meta) => {\n    try {\n      await apiWithRetry.post(`/forums/${forumId}/between-you-today/event`, {\n        event,\n        user_id: userId,\n        member_id: memberId,\n        intensity: meta?.intensity,\n        cache_hit: meta?.cache_hit,\n        date: meta?.date,\n        extra: meta?.extra\n      }, {\n        timeout: 4000\n      });\n    } catch {\n      // Telemetry must never affect UX. Silent on failure.\n    }\n  };\n\n  // =====================================================\n  // LIFE SYNTHESIS ENGINE (Phase 1a v1a2)\n  // =====================================================\n\n  const getLifeSynthesis = async (context, userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/${context}/synthesis/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n  const getLifeRoleCard = async (userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/role-card/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // MIRROR EVIDENCE LAYER (Phase 2)\n  // =====================================================\n\n  const getLifeEvidence = async (context, userId, refresh = false) => {\n    const response = await apiWithRetry.get(`/life/${context}/evidence/${userId}`, {\n      params: {\n        refresh: refresh ? 'true' : 'false',\n        _cb: Date.now()\n      }\n    });\n    return response.data;\n  };\n\n  // =====================================================\n  // TODAY MODULATION (Phase 2 continued)\n  // =====================================================\n\n  const getLifeToday = async (context, userId, refresh = false) => {