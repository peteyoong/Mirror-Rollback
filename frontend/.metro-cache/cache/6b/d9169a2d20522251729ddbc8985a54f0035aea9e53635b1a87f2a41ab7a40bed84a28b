n    // V3.1: Legacy content toggle for Today tab\n    const [legacyExpanded, setLegacyExpanded] = (0, _react.useState)(false);\n\n    // Debug: track raw API response length\n    const [rawDataLength, setRawDataLength] = (0, _react.useState)(0);\n\n    // Track mount count for debugging\n    const mountCount = (0, _react.useRef)(0);\n\n    // Load transit signals when Today tab is active\n    (0, _react.useEffect)(() => {\n      if (activeTab === 'today' && userId) {\n        loadTransitSignals();\n        loadFieldSignals();\n        // Load reflector synthesis if user is a Reflector\n        if (data?.core_mechanics?.type === 'Reflector') {\n          loadReflectorSynthesis();\n        }\n      }\n    }, [activeTab, userId, data?.core_mechanics?.type]);\n    const loadTransitSignals = async () => {\n      try {\n        setTransitLoading(true);\n        const response = await api.default.get(`/human-design/transit-signals/${userId}`);\n        setTransitSignals(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load transit signals:', error);\n      } finally {\n        setTransitLoading(false);\n      }\n    };\n    const loadFieldSignals = async () => {\n      try {\n        setFieldLoading(true);\n        const response = await api.default.get(`/human-design/field-signals/${userId}`);\n        setFieldSignals(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load field signals:', error);\n      } finally {\n        setFieldLoading(false);\n      }\n    };\n    const loadReflectorSynthesis = async () => {\n      try {\n        setReflectorSynthesisLoading(true);\n        const response = await api.default.get(`/journal/${userId}/reflector-synthesis`);\n        setReflectorSynthesis(response.data);\n      } catch (error) {\n        console.error('[HD] Failed to load reflector synthesis:', error);\n      } finally {\n        setReflectorSynthesisLoading(false);\n      }\n    };\n\n    // Load data when tab or user changes\n    (0, _react.useEffect)(() => {\n      loadTabData(activeTab);\n    }, [activeTab, userId]);\n\n    // Load centers definition for bodygraph highlighting when Deep Dive tab is active\n    (0, _react.useEffect)(() => {\n      if (activeTab === 'deep_dive') {\n        loadCentersDefinition();\n        loadDeepDiveData();\n      }\n    }, [activeTab, userId]);\n    const loadCentersDefinition = async () => {\n      try {\n        const response = await api.default.get(`/human-design/centers/${userId}`);\n        const centersDef = {};\n        response.data.centers?.forEach(c => {\n          // Map center_name to boolean defined status\n          const name = c.center_name || c.name;\n          if (name) {\n            centersDef[name.toLowerCase()] = c.defined === true;\n          }\n        });\n        setCentersDefinition(centersDef);\n        setCentersData(response.data); // Store full centers data for Deep Dive\n      } catch (err) {\n        console.error('Failed to load centers definition:', err);\n      }\n    };\n\n    // Load all Deep Dive data (gates, sequences)\n    const loadDeepDiveData = async () => {\n      try {\n        // Load gates data\n        const gatesResponse = await api.default.get(`/human-design/gates/${userId}`);\n        setGatesData(gatesResponse.data);\n      } catch (err) {\n        console.error('Failed to load gates:', err);\n      }\n      try {\n        // Load Gene Keys profile with all sequences\n        const sequencesResponse = await api.default.get(`/gene-keys/profile/${userId}`);\n        if (sequencesResponse.data) {\n          setActivationSequence(sequencesResponse.data.activation_sequence || null);\n          setVenusSequence(sequencesResponse.data.venus_sequence || null);\n          setPearlSequence(sequencesResponse.data.pearl_sequence || null);\n        }\n      } catch (err) {\n        console.error('Failed to load sequences:', err);\n      }\n    };\n\n    // Handle bodygraph center tap - opens 