# ============================================
# MIRROR - PRODUCTION ENVIRONMENT
# ============================================
# Production deployment - uses dedicated production backend
# ============================================

# Environment identifier
EXPO_PUBLIC_ENV=production

# API Configuration - PRODUCTION DEPLOYED HOST
# Replace with your production always-on deployment URL
EXPO_PUBLIC_API_BASE_URL=https://YOUR_PRODUCTION_HOST.emergent.host

# Build provenance
EXPO_PUBLIC_BUILD_VERSION=v_live_prod_001
EXPO_PUBLIC_BUILD_ID=live_YYYYMMDD_HHMMSS

# Debug mode (DISABLED in production)
EXPO_PUBLIC_DEBUG_MIRROR=false

# Expo tunnel config (update for production)
EXPO_TUNNEL_SUBDOMAIN=staging-hardening
EXPO_PACKAGER_HOSTNAME=https://YOUR_PRODUCTION_HOST.emergent.host
EXPO_USE_FAST_RESOLVER=1
METRO_CACHE_ROOT=/app/frontend/.metro-cache
