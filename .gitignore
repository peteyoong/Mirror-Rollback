# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
# Allow frontend/dist for Expo web build deployment
!frontend/dist/
!frontend/dist/**

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Data and databases
agenthub/agents/youtube/db

# Archive files and large assets
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Credentials / secrets (never commit)
*token.json*
*credentials.json*
*.key

# Local operator-only test credentials — must NOT be included in the deploy
# context (contains live seeded logins).
/memory/test_credentials.md
memory/test_credentials.md

# Environment files
# NOTE: Required runtime .env files (frontend/.env and backend/.env) MUST be
# available in the deployment context and are therefore explicitly allowed
# below.  Only genuinely local / secret .env variants should be ignored.
.env.local
.env.local.*
*.env.local
*.env.local.*
!frontend/.env
!backend/.env

model.patch
