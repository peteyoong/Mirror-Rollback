# ============================================
# MIRROR BACKEND - PRODUCTION ENVIRONMENT
# ============================================

# Environment identifier
ENV=prod

# MongoDB Atlas Production Database
# Replace with actual production MongoDB Atlas connection string
MONGO_URL="mongodb+srv://prod-user:PASSWORD@prod-cluster.mongodb.net"
DB_NAME="mirror_production"

# LLM API Key
EMERGENT_LLM_KEY=sk-emergent-YOUR_PROD_KEY

# Build provenance
BUILD_LABEL=prod-v1.0.0
GIT_SHA=auto-populated-at-deploy
