# ============================================
# MIRROR BACKEND - STAGING ENVIRONMENT
# ============================================
# Copy this to .env on the staging server
# Replace placeholder values with real credentials
# ============================================

# ⚠️ SECURITY: Generate fresh API keys for each environment
# Never reuse keys across environments or commit to version control

# =============================================
# REQUIRED VARIABLES (app will not start without these)
# =============================================

# MongoDB Atlas Connection String
# IMPORTANT: Include database name in the path (before the ?)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Example: mongodb+srv://mirror-staging:SecurePassword123@mirror-staging.abc123.mongodb.net/mirror_staging?retryWrites=true&w=majority
MONGO_URL="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/mirror_staging?retryWrites=true&w=majority"

# Database Name - MUST match the database in MONGO_URL path
# Recommended: mirror_staging
DB_NAME="mirror_staging"

# Emergent LLM API Key
# ⚠️ Generate a NEW key for staging - do not reuse dev/prod keys
# Get from: Emergent dashboard
EMERGENT_LLM_KEY="YOUR_NEW_EMERGENT_LLM_KEY"

# =============================================
# REQUIRED FOR ENVIRONMENT IDENTIFICATION
# =============================================

# Environment identifier - MUST be "staging"
ENV="staging"

# Build label - updated at deploy time
BUILD_LABEL="staging-v1.0.0"

# Git SHA - auto-populated by CI/CD or set manually
GIT_SHA="manual-deploy"

# =============================================
# OPTIONAL VARIABLES (have sensible defaults)
# =============================================

# Debug mode - set to "true" for verbose logging in staging
# Default: "false"
DEBUG_MIRROR="true"

# Enneagram PDF path (optional, for knowledge base)
# Default: /app/backend/data/JOH_Book_1.pdf
# ENNEAGRAM_PDF_PATH="/app/backend/data/JOH_Book_1.pdf"
